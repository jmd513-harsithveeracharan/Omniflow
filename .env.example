# =============================================================================
# Fabric AI Studio — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Priority routing: Claude → GPT → Gemini → Groq (first available key wins)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Groq — supports multiple keys for rate-limit fallback
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# ── Microsoft Fabric Workspace Lock ──────────────────────────────────────────
# Override the config.json workspace lock here (optional — config.json is also used)
FABRIC_ALLOWED_WORKSPACE_ID=
FABRIC_ALLOWED_WORKSPACE_NAME=

# ── Database & Storage (PostgreSQL + pgvector) ──────────────────────────────
# When running with Docker (docker compose up -d), use the URL below:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_ai
# If left unset or empty, the backend automatically falls back to local SQLite.


