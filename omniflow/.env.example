# ==============================================================================
# OmniFlow Autonomous Microsoft Fabric Platform — Environment Configuration
# ==============================================================================

# 1. PostgreSQL Metadata & Execution Catalog (Neon / Azure Postgres / Local)
# Required for agent registry, DAG orchestration, artifacts, and token tracking
NEON_DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or standard alias:
# DATABASE_URL=postgresql://user:password@localhost:5432/omniflow

# 2. Microsoft Fabric Target Workspace
# Set to your organization's Fabric Workspace ID & Name (from your browser URL / Fabric UI)
# The CLI will authenticate using your active 'az login' session
ALLOWED_WORKSPACE_ID=db7344c1-ecd9-44d6-849f-f2de49484f9f
ALLOWED_WORKSPACE_NAME=PBT_DATA_AGENT

# Optional: Target containment folder within the workspace
# Leave empty to deploy directly to the workspace root, or specify a folder name (e.g. PRJ-HEALTHCARE)
FABRIC_CONTAINMENT_FOLDER=

# 3. Azure OpenAI / LLM Provider Credentials
# Required for Planner, Research Agent, and Executor Agent code generation
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=omni-flow-gpt-6-luna
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# 4. Azure Entra ID / Fabric Service Principal (Optional - only if not using 'az login')
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
