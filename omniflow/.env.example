# ==============================================================================
# OmniFlow Standalone Environment Configuration Template
# Copy this file to .env and configure your secrets.
# ==============================================================================

# LLM Deployment Settings (Azure OpenAI or OpenAI)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=omni-flow-gpt-6-luna

# Microsoft Fabric Cloud Workspace
ALLOWED_WORKSPACE_ID=db7344c1-ecd9-44d6-849f-f2de49484f9f
# ALLOWED_WORKSPACE_NAME= (Optional: overrides dynamic Fabric REST API discovery)
FABRIC_TARGET_FOLDER=Workspace Root

# Neon Postgres Knowledge & Agent Persistence
NEON_DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# Server Port (Default: 8090)
PORT=8090
HOST=127.0.0.1
