    "project_summary": {
      "project_name": "Global Supply Chain & Inventory Fulfillment",
      "project_code": "PRJ-SUPPLYCHAIN-OPS",
      "business_domain": "Logistics, Procurement & Inventory Operations",
      "business_objective": "Unify warehouse inventory snapshots, inbound purchase orders, supplier master profiles, and outbound logistics shipments into Microsoft Fabric OneLake Medallion architecture for real-time stockout prevention and carrier performance analytics.",
      "business_context": "Disparate ERP warehouse management systems and supplier portals currently result in fragmented inventory visibility, unmasked supplier tax/contact data, and delayed fulfillment tracking."
    },
    "platform_summary": {
      "target_platform": "Microsoft Fabric",
      "target_environment": "DEV",
      "capacity_sku": "F64",
      "primary_language": "PySpark / T-SQL",
      "containment_folder": null
    },
    "solution_summary": {
      "requirement": "Ingest operational supply chain tables into Bronze lakehouse, curate with null-safe SHA-256 PII masking and Delta Lake ACID MERGE in Silver, construct Kimball dimensional warehouse star schema (fact_inventory_snapshot, fact_shipments, dim_warehouse, dim_supplier) in Gold, bind Direct Lake semantic model, and execute automated data quality reconciliation tests.",
      "expected_deliverables": [
        "01_workspace_manifest.json",
        "02_pl_raw_batch_ingest.json",
        "03_nb_curated_pii_merge.py",
        "04_warehouse_star_schema_ddl.sql",
        "05_sm_direct_lake_model.bim.json",
        "06_dq_reconciliation_suite.py",
        "07_lineage_graph.json"
      ],
      "success_criteria": [
        "Inventory snapshot and shipment count reconciliation variance < 0.5%",
        "100% of sensitive PII (tax identifiers, emails, phones) masked via null-safe SHA-256",
        "Zero circular DAG dependencies (Acyclic NetworkX graph)",
        "Delta Lake ACID MERGE upsert on primary keys with Z-Order compaction",
        "100% Python AST syntax validation passing on PySpark notebooks",
        "Kimball star schema surrogate keys (_sk) and SCD2 audit tracking in Gold",
        "All cloud resources provisioned in Microsoft Fabric workspace according to project architecture"
      ]
    }
