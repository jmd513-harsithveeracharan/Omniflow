    "request_type": "new_end_to_end_data_engineering_solution",
    "user_request": "Architect, provision, and deploy a HIPAA-compliant Microsoft Fabric Medallion data platform for Healthcare Clinical Encounters and Insurance Claims. Enforce Bronze raw ingestion, Silver Delta Lake curation with strict null-safe SHA-256 masking on patient PHI/PII (SSN, MRN, phone, address), Gold Kimball dimensional star schema warehouse for clinical outcomes and claim denial analytics, Direct Lake Power BI semantic modeling, and Great Expectations automated reconciliation testing.",
    "priority": "high",
    "planning_mode": "autonomous_create"
  },
  "project_context": {
    "project_summary": {
      "project_name": "Healthcare Clinical & Claims Intelligence",
      "project_code": "PRJ-HEALTHCARE-CLAIMS",
      "business_domain": "Healthcare Operations & Claims Analytics",
      "business_objective": "Consolidate patient admissions, physician encounters, pharmacy prescriptions, and insurance billing claims into Microsoft Fabric OneLake Medallion architecture to accelerate claims adjudication and patient readmission tracking while guaranteeing HIPAA compliance.",
      "business_context": "Siloed Electronic Health Record (EHR) systems and third-party payer claims databases cause high claim denial rates, unmasked PHI exposure, and delayed clinical quality reporting."
    },
    "platform_summary": {
      "target_platform": "Microsoft Fabric",
      "target_environment": "DEV",
      "capacity_sku": "F64",
      "primary_language": "PySpark / T-SQL",
      "containment_folder": null
    },
    "solution_summary": {
      "requirement": "Ingest operational EHR tables into Bronze lakehouse, curate with null-safe SHA-256 HIPAA PHI masking and Delta Lake ACID MERGE in Silver, construct Kimball star schema (fact_claims, fact_encounters, dim_patient, dim_provider) in Gold, bind Direct Lake semantic model, and execute automated data quality reconciliation tests.",
      "expected_deliverables": [
        "01_workspace_manifest.json",
        "02_pl_raw_batch_ingest.json",
        "03_nb_curated_pii_merge.py",
        "04_warehouse_star_schema_ddl.sql",
        "05_sm_direct_lake_model.bim.json",
        "06_dq_reconciliation_suite.py",
        "07_lineage_graph.json"
      ],
      "success_criteria": [
        "Patient encounter and claim row reconciliation variance < 0.2%",
        "100% of sensitive PHI/PII (SSN, MRN, phone, address, email) masked via null-safe SHA-256",
        "Zero circular DAG dependencies (Acyclic NetworkX graph)",
        "Delta Lake ACID MERGE upsert on primary keys with Z-Order compaction",
        "100% Python AST syntax validation passing on PySpark notebooks",
        "Kimball star schema surrogate keys (_sk) and SCD2 audit tracking in Gold",
        "All cloud resources provisioned in Microsoft Fabric workspace according to project architecture"
      ]
    }
  },
