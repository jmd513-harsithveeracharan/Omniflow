        "executive_kpis": [
          {
            "kpi_name": "Gross Merchandise Value (GMV)",
            "business_definition": "Total monetary volume of customer retail purchases before discounts and deductions.",
            "formula": "SUM(fact_sales_orders[line_total])",
            "dax_measure": "Total GMV = SUM(fact_sales_orders[line_total])"
          },
          {
            "kpi_name": "Net Sales Revenue",
            "business_definition": "Net recognized sales revenue after applying promotional discounts.",
            "formula": "SUM(fact_sales_orders[line_total]) * (1 - fact_sales_orders[discount_rate])",
            "dax_measure": "Net Sales Revenue = SUMX(fact_sales_orders, fact_sales_orders[line_total] * (1 - fact_sales_orders[discount_rate]))"
          },
          {
            "kpi_name": "Gross Profit Margin %",
            "business_definition": "Overall commercial profitability percentage after deducting product cost of goods sold.",
            "formula": "(SUM(estimated_profit) / SUM(line_total)) * 100",
            "dax_measure": "Gross Margin % = DIVIDE(SUM(fact_sales_orders[estimated_profit]), [Net Sales Revenue], 0) * 100"
          },
          {
            "kpi_name": "Average Order Value (AOV)",
            "business_definition": "Average transaction revenue generated per unique customer purchase order.",
            "formula": "[Net Sales Revenue] / DISTINCTCOUNT(fact_sales_orders[order_id])",
            "dax_measure": "AOV = DIVIDE([Net Sales Revenue], DISTINCTCOUNT(fact_sales_orders[order_number]), 0)"
          },
          {
            "kpi_name": "On-Time In-Full Delivery (OTIF %)",
            "business_definition": "Percentage of shipments delivered to customer within the promised delivery window.",
            "formula": "(COUNT(shipments WHERE is_on_time_flag = 1) / COUNT(shipments)) * 100",
            "dax_measure": "OTIF % = DIVIDE(CALCULATE(COUNTROWS(fact_order_fulfillment), fact_order_fulfillment[is_on_time_flag] = 1), COUNTROWS(fact_order_fulfillment), 0) * 100"
          },
          {
            "kpi_name": "Omnichannel Revenue Split %",
            "business_definition": "Proportion of total revenue generated by Online Direct vs. Physical Stores.",
            "formula": "CALCULATE([Net Sales Revenue], dim_store[channel_type] = 'online') / [Net Sales Revenue]",
            "dax_measure": "Online Revenue % = DIVIDE(CALCULATE([Net Sales Revenue], dim_store[channel_type] = \"online\"), [Net Sales Revenue], 0) * 100"
          },
          {
            "kpi_name": "Inventory Stockout Risk Count",
            "business_definition": "Number of product SKUs whose on-hand inventory has dropped below the safety reorder point.",
            "formula": "COUNT(inventory_snapshots WHERE quantity_on_hand <= reorder_point)",
            "dax_measure": "Stockout Risk Items = CALCULATE(DISTINCTCOUNT(fact_inventory_daily[product_sk]), fact_inventory_daily[stockout_risk_flag] = 1)"
          },
          {
            "kpi_name": "Inventory Holding Valuation ($)",
            "business_definition": "Total monetary capital value of inventory currently held across all warehouses and stores.",
            "formula": "SUM(fact_inventory_daily[inventory_holding_value])",
            "dax_measure": "Total Inventory Value = SUM(fact_inventory_daily[inventory_holding_value])"
          },
          {
            "kpi_name": "Return Rate %",
            "business_definition": "Proportion of ordered merchandise returned by customers for refund.",
            "formula": "(SUM(fact_customer_returns[refund_amount]) / [Net Sales Revenue]) * 100",
            "dax_measure": "Return Rate % = DIVIDE(SUM(fact_customer_returns[refund_amount]), [Net Sales Revenue], 0) * 100"
          },
          {
            "kpi_name": "Customer Lifetime Value (LTV)",
            "business_definition": "Cumulative sales revenue generated per customer across all historical purchase orders.",
            "formula": "SUM(fact_sales_orders[line_total]) / DISTINCTCOUNT(fact_sales_orders[customer_sk])",
            "dax_measure": "Customer LTV = DIVIDE([Net Sales Revenue], DISTINCTCOUNT(fact_sales_orders[customer_sk]), 0)"
          },
          {
            "kpi_name": "VIP Segment Revenue Share %",
            "business_definition": "Percentage of net revenue contributed by VIP and Preferred Gold tier customers.",
            "formula": "CALCULATE([Net Sales Revenue], dim_customer[loyalty_tier] IN {'PLATINUM', 'GOLD'}) / [Net Sales Revenue]",
            "dax_measure": "VIP Revenue Share % = DIVIDE(CALCULATE([Net Sales Revenue], dim_customer[loyalty_tier] IN {\"PLATINUM\", \"GOLD\"}), [Net Sales Revenue], 0) * 100"
          },
          {
            "kpi_name": "Procurement Lead Time Variance (Days)",
            "business_definition": "Average days difference between promised supplier delivery date and actual arrival date.",
            "formula": "AVERAGE(purchase_orders[received_date] - purchase_orders[expected_date])",
            "dax_measure": "Avg Lead Time Variance = AVERAGE(fact_order_fulfillment[delivery_variance_hours]) / 24"
          }
        ],
        "master_orchestrator_specification": {
          "pipeline_name": "pl_retail_medallion_master",
          "folder_location": "Pipeline Orchestration",
          "description": "Enterprise-grade top-level Microsoft Fabric Data Factory DAG coordinating multi-wave execution across Medallion layers.",
          "dag_execution_waves": [
            {
              "wave_index": 1,
              "name": "Bronze Raw Ingestion (32 Tables)",
              "activity": "ExecutePipeline",
              "target_item": "pl_retail_bronze_ingest",
              "folder": "01 Raw",
              "description": "Extracts 32 operational tables from PostgreSQL schema 'retail_ops' into Bronze Lakehouse 'lh_retail_bronze' with full audit metadata."
            },
            {
              "wave_index": 2,
              "name": "Silver Delta Curation & PII Masking",
