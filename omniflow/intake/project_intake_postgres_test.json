    "solution_summary": {
      "target_architecture": "Microsoft Fabric Medallion Architecture (PostgreSQL Source -> 01 Raw Bronze -> 02 Stage Curation -> 03 Silver Harmonized -> 04 Gold Kimball Warehouse)",
      "target_folder_structure": {
        "root_folder": "Postgres_Medallion_Platform",
        "subfolders": {
          "raw": "01 Raw",
          "stage": "02 Stage",
          "silver": "03 Silver",
          "gold": "04 Gold"
        }
      },
      "engineering_best_practices": [
        "Bronze Layer (01 Raw): Immutable append-only Delta landing with original types preserved plus _ingested_at, _source_schema, and _batch_run_id metadata columns.",
        "Incremental Watermark Strategy: High-watermark CDC extraction on updated_at / started_at / created_at for transactional & telemetry tables; full snapshot refresh for small reference/config tables.",
        "Stage Curation (02 Stage): Windowed ROW_NUMBER() deduplication partitioned by Primary Key ordered by latest watermark DESC; strict schema evolution & null-key quarantine routing.",
        "Security & Privacy: Drop secret columns (users.password_hash) prior to Silver; apply salted SHA-256 deterministic masking to PII fields (email, phone, street_address, first_name, last_name).",
        "Silver Layer (03 Silver): Idempotent Delta MERGE INTO upserts enforced on primary keys, normalized money/numeric precisions (DECIMAL(12,6)), trimmed standardized text, and validated FK referential checks.",
        "Gold Layer (04 Gold): Kimball Star Schema modeled for Direct Lake Power BI analytics with dim_customer, dim_product, dim_project, dim_agent, fact_sales_orders, fact_agent_executions, and fact_llm_token_cost."
      ],
      "expected_deliverables": [
        "lh_postgres_medallion_bronze (Lakehouse in 01 Raw)",
        "pl_postgres_medallion_bronze_ingest (DataPipeline in 01 Raw with externalConnections)",
        "nb_postgres_medallion_curate (PySpark Notebook in 02 Stage)",
        "lh_postgres_medallion_silver (Lakehouse in 03 Silver)",
        "wh_postgres_medallion_gold (Warehouse in 04 Gold)"
      ]
    }
  },
  "retrieved_context": {
    "data_sources": [
      {
        "source_name": "PostgreSQL Platform & Source CRM Database",
        "system_type": "PostgreSQL / Neon",
        "connector_type": "postgres",
        "schemas_in_scope": ["source_crm", "public"],
        "discover_all_tables_on_connect": true,
        "cleaning_and_transformation_rules": [
          {
            "table": "source_crm.customers",
            "rule": "Trim/INITCAP first_name & last_name, normalize email lowercase before SHA-256 hashing, mask phone & street_address, deduplicate on customer_id by updated_at DESC."
          },
          {
            "table": "source_crm.orders",
            "rule": "Cast total_amount DECIMAL(12,2), standardize status uppercase, reject negative totals to quarantine table, validate customer_id FK against Silver dim_customer."
          },
          {
            "table": "source_crm.order_items",
            "rule": "Assert quantity > 0 and discount BETWEEN 0 AND 1; recompute net_line_amount = ROUND(quantity * unit_price - COALESCE(discount, 0), 2) and reconcile against source_crm.orders.total_amount."
          },
          {
            "table": "public.users",
            "rule": "Exclude password_hash before promoting to Silver; apply deterministic SHA-256 hashing to email; standardize user display names."
          },
          {
            "table": "public.llm_token_logs",
            "rule": "Coalesce cached_tokens to 0, compute effective_billed_tokens = prompt_tokens + completion_tokens, cast total_cost_usd to DECIMAL(12,6), enforce run_id and project_id FK joins."
          },
          {
            "table": "public.agent_runs",
            "rule": "Derive duration_seconds = DATEDIFF(second, started_at, completed_at), flatten token_usage JSONB metrics into typed integer columns, filter invalid run references."
          }
        ],
        "relationships": [
          "source_crm.orders.customer_id -> source_crm.customers.customer_id (Many-to-One)",
          "source_crm.order_items.order_id -> source_crm.orders.order_id (Many-to-One)",
