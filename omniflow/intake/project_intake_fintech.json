  "data_quality_reconciliation": {
    "suite_name": "Fintech_Wire_Settlement_Audit_Suite",
    "strict_mode": true,
    "rules": [
      {
        "target_table": "wire_transfers",
        "assertion": "expect_column_values_to_not_be_null",
        "column": "uetr_transaction_id",
        "tolerance": 0.0
      },
      {
        "target_table": "wire_transfers",
        "assertion": "expect_column_values_to_be_between",
        "column": "instructed_amount",
        "min_value": 0.01,
        "max_value": 100000000.0,
        "action_on_failure": "QUARANTINE_ROW"
      },
      {
        "target_table": "customer_accounts",
        "assertion": "expect_column_values_to_match_regex",
        "column": "tax_identifier_ssn",
        "regex": "^[A-Fa-f0-9]{64}$",
        "description": "Ensure 100% of SSNs in Silver/Gold are SHA-256 hashed before ingestion"
      },
      {
        "target_table": "settlement_batches",
        "assertion": "expect_column_values_to_be_in_set",
        "column": "reconciliation_status",
        "value_set": ["BALANCED", "DISCREPANCY_FLAGGED", "PENDING"]
      }
    ]
  },
  "analytical_gold_models": {
    "fact_tables": [
      {
        "name": "Fact_WireSettlement",
        "grain": "One row per settled or attempted wire transaction",
        "primary_key": "SettlementKey",
        "foreign_keys": ["CustomerKey", "SanctionKey", "CurrencyKey", "DateKey"],
        "measures": [
          "SettlementAmountUSD",
          "InstructedAmount",
          "ExchangeRateApplied",
          "AMLScore",
          "ProcessingLatencySeconds"
        ]
      }
    ],
    "dimension_tables": [
      { "name": "Dim_CustomerAccount", "type": "SCD Type 2", "surrogate_key": "CustomerKey", "natural_key": "account_id" },
      { "name": "Dim_SanctionEntity", "type": "SCD Type 1", "surrogate_key": "SanctionKey", "natural_key": "entity_id" },
      { "name": "Dim_CurrencyPair", "type": "SCD Type 1", "surrogate_key": "CurrencyKey", "natural_key": "currency_pair_id" },
      { "name": "Dim_Date", "type": "Conformed Role-Playing", "surrogate_key": "DateKey", "natural_key": "calendar_date" }
    ],
    "power_bi_dax_kpis": [
      { "name": "Total Settlement Volume USD", "expression": "SUM(Fact_WireSettlement[SettlementAmountUSD])", "format": "$#,##0.00" },
      { "name": "AML Block Rate %", "expression": "DIVIDE(CALCULATE(COUNTROWS(Fact_WireSettlement), Fact_WireSettlement[Status] = \"REJECTED\"), COUNTROWS(Fact_WireSettlement)) * 100", "format": "0.00%" },
      { "name": "Average Processing Time Sec", "expression": "AVERAGE(Fact_WireSettlement[ProcessingLatencySeconds])", "format": "#,##0.0s" },
      { "name": "5-Min SLA Compliance %", "expression": "DIVIDE(CALCULATE(COUNTROWS(Fact_WireSettlement), Fact_WireSettlement[ProcessingLatencySeconds] <= 300), COUNTROWS(Fact_WireSettlement)) * 100", "format": "0.00%" }
    ]
  }
